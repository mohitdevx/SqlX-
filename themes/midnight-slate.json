{
  "$schema": "./theme.schema.json",
  "name": "Midnight Slate",
  "type": "dark",
  "colors": {
    "background": {
      "base": "#0b0f19",
      "surface": "#111827",
      "overlay": "#1f2937",
      "elevated": "#374151"
    },
    "border": {
      "subtle": "#1f2937",
      "default": "#374151",
      "strong": "#4b5563"
    },
    "text": {
      "primary": "#f9fafb",
      "secondary": "#9ca3af",
